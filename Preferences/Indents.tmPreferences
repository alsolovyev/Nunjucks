<?xml version="1.0" encoding="UTF-8"?>
<plist version="1.0">
<dict>
  <key>name</key>
  <string>Indents</string>
  <key>scope</key>
  <string>text.html.njk</string>
  <key>settings</key>
  <dict>
    <key>increaseIndentPattern</key>
    <string><![CDATA[(?x)
(?:
  ^.* (
      <(?!
          !--
        | [?%]
        | (?i:!doctype)
        | (?i:area|base|br|col|frame|hr|html|img|input|link|meta|param)[\t\n\f /<>]
      )(?:
        (?<html_tag>[^\t\n\f /<>]+)
        (?:(?!/>)[^>])* >
        (?! .* </\k<html_tag>)
      )
    | <\?(?!.*?\?>)
    | <\%(?!.*?\%>)
    | \{(?=\s*(?:<!--.*)?$)
  )
)
|
(?:
  ^\s*+ \{%-? \s*+
  (?:
      \b(?:if|elif|elseif|else|for|asyncEach|asyncAll|macro|block|raw|verbatim|filter|call)\b (?:(?!%\}).)* -?%\}
    | \bset\b (?:(?!=|%\}).)* -?%\}
  )
  \s*$
)
    ]]></string>
    <key>decreaseIndentPattern</key>
    <string><![CDATA[(?x)
    ^[^<>]*+ </ (?!html[\t\n\f /<>])[^\t\n\f /<>]+ [^>]* >
  | ^[\t\n\f ]*+
    (
        --> [\t\n\f ]* </ (?: script | style )[\t\n\f /<>]
      | [?%]>
      | \}
    )
  | ^\s*+ \{%-? \s*+
    \b(?:elif|elseif|else|endif|endfor|endeach|endall|endmacro|endblock|endraw|endverbatim|endfilter|endcall|endset)\b
    (?:(?!%\}).)* -?%\} \s*$
    ]]></string>
  </dict>
</dict>
</plist>
